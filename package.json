{
  "name": "wicked-imgui-maker-qa",
  "version": "0.0.0",
  "private": true,
  "description": "Offline QA runners for Wicked ImGui Maker. No runtime dependencies — everything uses Node, Python and the checked-in toolchains.",
  "scripts": {
    "test": "node qa.mjs",
    "test:regression": "node regression.mjs",
    "test:ai-contract": "node test-ai-contract.js",
    "test:visual": "node visual-regression.mjs",
    "test:browser": "node browser-visual.mjs",
    "browser:update": "node browser-visual.mjs --update",
    "visual:update": "node visual-regression.mjs --update"
  }
}
